# Copy this file to .env and fill in real values before deploying.

PORT=4000

# Leave PAYSTACK_SECRET_KEY empty during development.
# The app runs in DEV/MOCK mode without it: orders are created normally,
# but "payment" is simulated locally instead of calling Paystack.
# Add your live/test secret key (starts with sk_) to switch to real payments.
PAYSTACK_SECRET_KEY=

# The public URL of THIS backend (used to build the Paystack callback_url).
PUBLIC_BASE_URL=http://localhost:4000

# The URL of the frontend (used to redirect the customer back after payment).
# The backend serves the frontend directly at its own root (see server.js),
# so in local dev this is the same address as PUBLIC_BASE_URL. Only change
# this if you deploy the frontend separately (its own domain/CDN).
FRONTEND_URL=http://localhost:4000

# --- Admin dashboard (visit /admin) ---
# Leave ADMIN_PASSWORD empty to keep the dashboard disabled.
ADMIN_USERNAME=admin
ADMIN_PASSWORD=

# --- Order email notifications ---
# Leave SMTP_HOST empty to keep notifications in dev mode (logged to the
# server console instead of emailed). Any SMTP provider works — Gmail
# (with an app password), Zoho, SendGrid, Mailgun, etc.
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
SMTP_FROM=
# Where order notifications get sent — usually your own inbox.
ADMIN_NOTIFY_EMAIL=
